{
  "name": "@nslookup-io/mcp-server",
  "version": "1.5.0",
  "mcpName": "io.github.venomseven/nslookup",
  "description": "MCP server for DNS lookups (53 record types), DNS health reports (39 checks), global propagation checks, RDAP registration data, hosting reports, DNS change review, SSL/TLS certificates, BIMI/VMC, security scans, GEO (AI readiness) scoring, multi-location uptime monitoring, and public status pages via nslookup.io",
  "main": "dist/index.js",
  "bin": {
    "mcp-server": "dist/index.js",
    "nslookup-mcp": "dist/index.js",
    "nslookup-mcp-http": "dist/http.js"
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc",
    "start": "node dist/index.js",
    "start:http": "node dist/http.js",
    "dev": "tsc --watch",
    "smoke": "node scripts/smoke-auth.mjs",
    "prepublishOnly": "npm run build"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/nslookup-io/nslookup-mcp.git"
  },
  "keywords": [
    "mcp",
    "dns",
    "nslookup",
    "propagation",
    "dns-lookup",
    "dns-health",
    "dnssec",
    "model-context-protocol",
    "claude",
    "ai-tools"
  ],
  "author": "nslookup.io",
  "license": "Apache-2.0",
  "bugs": {
    "url": "https://github.com/nslookup-io/nslookup-mcp/issues"
  },
  "homepage": "https://nslookup.io",
  "engines": {
    "node": ">=18"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.27.1",
    "express": "^5.1.0",
    "jose": "^5.10.0",
    "zod": "^4.3.6"
  },
  "devDependencies": {
    "@types/express": "^5.0.2",
    "@types/node": "^25.5.0",
    "typescript": "^5.9.3"
  }
}
